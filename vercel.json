{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "eleventy",
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/what-i-do/process/",
      "destination": "/about/#process",
      "permanent": true
    },
    {
      "source": "/what-i-do/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/experience/",
      "destination": "/about/#experience",
      "permanent": true
    },
    {
      "source": "/ar/what-i-do/process/",
      "destination": "/ar/about/#process",
      "permanent": true
    },
    {
      "source": "/ar/what-i-do/",
      "destination": "/ar/services/",
      "permanent": true
    },
    {
      "source": "/ar/experience/",
      "destination": "/ar/about/#experience",
      "permanent": true
    }
  ]
}
