{
  "name": "aminetestouri.xyz",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio of Mo.Amine Testouri, product designer.",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "test": "node --test tests/static.test.js",
