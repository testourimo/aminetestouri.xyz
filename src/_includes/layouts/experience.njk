---
layout: layouts/base.njk
---
{% from "partials/button.njk" import button %}
{% include "partials/page-intro.njk" %}

<section class="section">
  <div class="container grid">
    <div class="facts d-span-4 t-span-4">
      <h2 class="h4">{{ sectorsHeading }}</h2>
      <ul role="list">
        {%- for item in sectors %}<li class="body">{{ item }}</li>{% endfor %}
      </ul>
    </div>
    <div class="facts d-span-4 t-span-4">
      <h2 class="h4">{{ productsHeading }}</h2>
      <ul role="list">
        {%- for item in products %}<li class="body">{{ item }}</li>{% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="section">
  <div class="container grid">
    <div class="prose body d-span-8">
      {{ content | safe }}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="edu-title">
  <div class="container">
    <h2 class="h2" id="edu-title">{{ educationHeading }}</h2>
    <ul class="index-list" role="list" style="margin-top: var(--space-6)">
      {%- for item in education %}
      <li class="index-list__item">
        <span class="index-list__num">{{ loop.index | pad }}</span>
        <h3 class="index-list__title h4 latin">{{ item.name }}</h3>
        <p class="index-list__body body">{{ item.detail }}</p>
      </li>
      {%- endfor %}
    </ul>
    <div class="actions">
      {{ button(cta, "what-i-do" | urlFor(lang), "primary", "arrow-right") }}
    </div>
  </div>
</section>
