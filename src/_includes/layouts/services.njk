---
layout: layouts/base.njk
---
{% from "partials/button.njk" import button %}
{% include "partials/page-intro.njk" %}

<section class="section">
  <div class="container">
    <ol class="index-list" role="list">
      {%- for service in services %}
      <li class="index-list__item" id="{{ service.slug }}">
        <span class="index-list__num">{{ loop.index | pad }}</span>
        <h2 class="index-list__title h3">{{ service.title | t(lang) }}</h2>
        <p class="index-list__body body">{{ service.body | t(lang) }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="callout grid">
      <div class="d-span-8">
        <h2 class="display-lg">{{ processHeading }}</h2>
        <p class="body muted" style="margin-top: var(--space-3)">{{ processLead }}</p>
        <div class="actions">
          {{ button(ui.readProcess | t(lang), "process" | urlFor(lang), "primary", "arrow-right") }}
        </div>
      </div>
    </div>
  </div>
</section>
