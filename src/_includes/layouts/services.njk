---
layout: layouts/base.njk
---
{% from "partials/button.njk" import button %}
{% include "partials/page-intro.njk" %}

<section class="section" aria-labelledby="services-title">
  <div class="container">
    <h2 class="visually-hidden" id="services-title">{{ title }}</h2>
    <ol class="index-list" role="list">
      {%- for service in services %}
      <li class="index-list__item" id="{{ service.slug }}">
        <span class="index-list__num">{{ loop.index | pad }}</span>
        <h3 class="index-list__title h3">{{ service.title | t(lang) }}</h3>
        <p class="index-list__body body">{{ service.body | t(lang) }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section" id="process" aria-labelledby="process-title">
  <div class="container">
    <div class="section__head">
      <div>
        <h2 class="h2" id="process-title">{{ processHeading }}</h2>
        <p class="body muted" style="margin-top: var(--space-3)">{{ processLead }}</p>
      </div>
    </div>
    <ol class="index-list index-list--steps" role="list">
      {%- for step in process %}
      <li class="index-list__item">
        <span class="index-list__num" aria-hidden="true">{{ loop.index | pad }}</span>
        <h3 class="index-list__title h3"><span class="visually-hidden">{{ loop.index }}. </span>{{ step.title | t(lang) }}</h3>
        <p class="index-list__body body">{{ step.body | t(lang) }}</p>
      </li>
      {%- endfor %}
    </ol>
    <div class="actions">
      {{ button(cta, "contact" | urlFor(lang), "primary", "arrow-right") }}
    </div>
  </div>
</section>
