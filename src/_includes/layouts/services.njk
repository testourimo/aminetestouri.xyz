---
layout: layouts/base.njk
---
{% from "partials/button.njk" import button %}
{% from "partials/section-head.njk" import sectionHead %}
{% include "partials/hero.njk" %}

<section class="section" data-iso="draw" aria-labelledby="services-title">
  <div class="container">
    {% call sectionHead("services", sections.services) %}
      {{ button(ui.readProcess | t(lang), "#process", "text", "arrow-right") }}
    {% endcall %}
    <ol class="index-list" role="list">
      {%- for service in services %}
      <li class="index-list__item" id="{{ service.slug }}" data-iso="slide" data-d="{{ loop.index0 }}">
        <span class="index-list__lead" aria-hidden="true">
          <span class="index-list__num">{{ loop.index | pad }}</span>
          {% isoicon service.icon, 64 %}
        </span>
        <h3 class="index-list__title h3">{{ service.title | t(lang) }}</h3>
        <p class="index-list__body body">{{ service.body | t(lang) }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section" data-iso="draw" id="process" aria-labelledby="process-title">
  <div class="container">
    {% call sectionHead("process", sections.process) %}
      {{ button(sections.process.cta, "contact" | urlFor(lang), "primary", "arrow-right") }}
    {% endcall %}
    {#- Hairline with a coral square travelling along it; it doubles as the list's top rule. #}
    <div class="iso-pulse" data-iso="pulse" aria-hidden="true"><span class="iso-pulse__sq"></span></div>
    <ol class="index-list index-list--steps" role="list">
      {%- for step in process %}
      <li class="index-list__item" data-iso="slide" data-d="{{ loop.index0 }}">
        <span class="index-list__lead" aria-hidden="true">
          <span class="index-list__num" data-iso="count" data-to="{{ loop.index }}">{{ loop.index | pad }}</span>
          {% stack loop.index, loop.length, loop.index0 %}
        </span>
        <h3 class="index-list__title h3"><span class="visually-hidden">{{ loop.index }}. </span>{{ step.title | t(lang) }}</h3>
        <p class="index-list__body body">{{ step.body | t(lang) }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
