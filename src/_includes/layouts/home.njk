---
layout: layouts/base.njk
---
{% from "partials/button.njk" import button %}
{% from "partials/section-head.njk" import sectionHead %}

{% set heroActions %}
  {{ button(ui.getInTouch | t(lang), "contact" | urlFor(lang), "primary", "arrow-right") }}
  {{ button(ui.allServices | t(lang), "services" | urlFor(lang), "outlined", "arrow-up-right") }}
{% endset %}
{% include "partials/hero.njk" %}

<section class="section" aria-labelledby="work-title">
  <div class="container">
    {% call sectionHead("work", sections.work) %}
      <div class="scroller-nav" data-scroller-nav hidden>
        <button class="icon-btn" type="button" data-scroll="prev" aria-label="{{ ui.previous | t(lang) }}">{% icon "arrow-left", 20 %}</button>
        <button class="icon-btn" type="button" data-scroll="next" aria-label="{{ ui.next | t(lang) }}">{% icon "arrow-right", 20 %}</button>
      </div>
    {% endcall %}
    {#- Scrolls sideways out to the frame lines, the one thing allowed to cross the safe space. #}
    <ul class="scroller" role="list" tabindex="0" aria-labelledby="work-title" data-scroller data-autoplay="40">
      {%- for project in work %}
      <li class="scroller__item">{% include "partials/card-thumb.njk" %}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="services-title">
  <div class="container">
    {% call sectionHead("services", sections.services) %}
      {{ button(ui.allServices | t(lang), "services" | urlFor(lang), "text", "arrow-right") }}
    {% endcall %}
    <div class="grid card-grid">
      {%- for service in services %}{% if loop.index <= 3 %}
      {%- set index = loop.index %}
      {%- set href = ("services" | urlFor(lang)) + "#" + service.slug %}
      {% include "partials/card-glow.njk" %}
      {%- endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="contact-title">
  <div class="container">
    {% call sectionHead("contact", sections.contact) %}
      {{ button(ui.getInTouch | t(lang), "contact" | urlFor(lang), "primary", "arrow-right") }}
      {{ button(ui.readProcess | t(lang), ("services" | urlFor(lang)) + "#process", "outlined", "arrow-up-right") }}
    {% endcall %}
  </div>
</section>
