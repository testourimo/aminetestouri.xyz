---
layout: layouts/base.njk
---
{% from "partials/button.njk" import button %}

<section class="hero">
  <div class="container grid hero__grid">
    <div class="hero__text">
      <p class="hero__eyebrow label"><span class="latin">{{ site.name }}</span> · {{ site.role | t(lang) }}</p>
      <h1 class="hero__headline">{{ headline }}</h1>
      <p class="hero__lede body">{{ lede }}</p>
      <div class="actions">
        {{ button(ui.getInTouch | t(lang), "contact" | urlFor(lang), "primary", "arrow-right") }}
        {{ button(ui.allServices | t(lang), "what-i-do" | urlFor(lang), "outlined", "arrow-up-right") }}
      </div>
    </div>
    <div class="hero__pattern">
      {% iso { cols: 9, rows: 22, side: 48 } %}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="work-title">
  <div class="container">
    <div class="section__head">
      <h2 class="h2" id="work-title">{{ ui.selectedWork | t(lang) }}</h2>
      <div class="scroller-nav" data-scroller-nav hidden>
        <button class="icon-btn" type="button" data-scroll="prev" aria-label="{{ ui.previous | t(lang) }}">{% icon "arrow-left", 20 %}</button>
        <button class="icon-btn" type="button" data-scroll="next" aria-label="{{ ui.next | t(lang) }}">{% icon "arrow-right", 20 %}</button>
      </div>
    </div>
    {#- Scrolls sideways inside the container, so cards clip at the page's own edges. #}
    <ul class="scroller" role="list" tabindex="0" aria-labelledby="work-title" data-scroller data-autoplay="4000">
      {%- for project in work %}
      <li class="scroller__item">{% include "partials/card-thumb.njk" %}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="services-title">
  <div class="container">
    <div class="section__head">
      <h2 class="display-lg" id="services-title">{{ servicesHeading }}</h2>
      {{ button(ui.allServices | t(lang), "what-i-do" | urlFor(lang), "text", "arrow-right") }}
    </div>
    <div class="grid card-grid">
      {%- for service in services %}{% if loop.index <= 3 %}
      {%- set index = loop.index %}
      {%- set href = ("what-i-do" | urlFor(lang)) + "#" + service.slug %}
      {% include "partials/card-glow.njk" %}
      {%- endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="callout grid">
      <div class="d-span-8">
        <p class="display-quote">{{ closing }}</p>
        <div class="actions">
          {{ button(ui.getInTouch | t(lang), "contact" | urlFor(lang), "primary", "arrow-right") }}
          {{ button(ui.readProcess | t(lang), "process" | urlFor(lang), "outlined", "arrow-up-right") }}
        </div>
      </div>
    </div>
  </div>
</section>
