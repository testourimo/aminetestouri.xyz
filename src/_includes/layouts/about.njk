---
layout: layouts/base.njk
---
{% from "partials/button.njk" import button %}
{% from "partials/section-head.njk" import sectionHead %}
{% include "partials/hero.njk" %}

<section class="section" aria-labelledby="about-title">
  <div class="container">
    {% call sectionHead("about", sections.about) %}{% endcall %}
    <div class="grid">
      <div class="about__portrait">
        {% figure "portrait/portrait.jpg", portraitAlt, "4/5", portraitLabel %}
      </div>
      <div class="about__text prose body">
        {{ content | safe }}
        <div class="about__experience" id="experience">
          <h3 class="h3">{{ sections.experience.title }}</h3>
          <p class="body muted">{{ sections.experience.sub }}</p>
          <div class="about__facts">
            <div class="facts">
              <h4 class="h4">{{ experience.sectorsHeading }}</h4>
              <ul role="list">
                {%- for item in experience.sectors %}<li class="body">{{ item }}</li>{% endfor %}
              </ul>
            </div>
            <div class="facts">
              <h4 class="h4">{{ experience.productsHeading }}</h4>
              <ul role="list">
                {%- for item in experience.products %}<li class="body">{{ item }}</li>{% endfor %}
              </ul>
            </div>
          </div>
          {%- for paragraph in experience.notes %}
          <p class="body">{{ paragraph }}</p>
          {%- endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section" id="process" aria-labelledby="process-title">
  <div class="container">
    {% call sectionHead("process", sections.process) %}
      {{ button(sections.process.cta, "contact" | urlFor(lang), "primary", "arrow-right") }}
    {% endcall %}
    <div class="process-flow">
      {#- Left rail: one bar per stage, filling as that stage's card scrolls in. #}
      <ol class="process-rail" role="list" aria-hidden="true">
        {%- for step in process %}
        <li class="process-rail__item" data-rail>
          <span class="process-rail__num">{{ loop.index | pad }}</span>
          <span class="process-rail__name">{{ step.title | t(lang) }}</span>
          <span class="process-rail__bar"><i data-rail-bar></i></span>
        </li>
        {%- endfor %}
      </ol>
      {#- Cards fill the rest of the width and stack: each one slides over the previous. #}
      <ol class="process-cards" role="list">
        {%- for step in process %}
        <li class="stage-card" data-stage style="--i: {{ loop.index0 }}">
          <div class="stage-card__text">
            <span class="stage__num" aria-hidden="true">{{ loop.index | pad }}</span>
            <h3 class="stage__title h3"><span class="visually-hidden">{{ loop.index }}. </span>{{ step.title | t(lang) }}</h3>
            <p class="stage__body body">{{ step.body | t(lang) }}</p>
            <dl class="stage__out"><dt>{{ ui.youGet | t(lang) }}</dt><dd>{{ step.out | t(lang) }}</dd></dl>
          </div>
          <div class="stage-card__art" aria-hidden="true">
            {% isoScene loop.index %}
          </div>
        </li>
        {%- endfor %}
      </ol>
    </div>
  </div>
</section>
