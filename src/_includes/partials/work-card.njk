{# One project thumbnail. Expects `project` from src/_data/work.json. #}
{% set tag = "a" if project.href else "div" %}
<{{ tag }} class="work-card{% if project.href %} at-draw{% endif %}"{% if project.href %} href="{{ project.href }}"{% endif %}>
  {% figure project.thumbnail, (project.title | t(lang)), "4/3", ("Thumbnail · 1600 × 1200" if lang == "en" else "صورة مصغّرة · 1600 × 1200"), "work-card__thumb" %}
  <div class="work-card__meta">
    <h3 class="work-card__title">{{ project.title | t(lang) }}</h3>
    {% if project.href %}<span class="at-btn__icon">{% icon "arrow-up-right" %}</span>{% endif %}
  </div>
  <ul class="tag-list" role="list">
    <li class="at-tag at-tag--blue">{{ project.sector | t(lang) }}</li>
    <li class="at-tag at-tag--line">{{ project.type | t(lang) }}</li>
  </ul>
  {% if not project.href %}<p class="small work-card__status">{{ ui.caseStudySoon | t(lang) }}</p>{% endif %}
</{{ tag }}>
