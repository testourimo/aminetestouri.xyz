{#
  Section head: every section opens with a title, a one-line subheading and,
  depending on the section, controls on the end side (buttons, links, scroller arrows).

  {% from "partials/section-head.njk" import sectionHead %}
  {% call sectionHead("work", sections.work) %}
    ...controls, or nothing...
  {% endcall %}
#}
{% macro sectionHead(id, copy) %}
{%- set controls = caller() if caller else "" %}
<header class="section-head">
  <div class="section-head__text">
    <h2 class="section-head__title" id="{{ id }}-title">{{ copy.title }}</h2>
    {% if copy.sub %}<p class="section-head__sub">{{ copy.sub }}</p>{% endif %}
  </div>
  {% if (controls | trim | length) > 0 %}<div class="section-head__controls">{{ controls | safe }}</div>{% endif %}
</header>
{% endmacro %}
