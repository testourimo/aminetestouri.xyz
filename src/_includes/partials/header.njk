{% from "partials/logo.njk" import lockup %}
<header class="site-header">
  <div class="container site-header__inner">
    <a class="at-logo at-lockup at-lockup--sm site-header__logo" href="{{ 'home' | urlFor(lang) }}" aria-label="{{ site.wordmark }}, {{ (nav[0].label | t(lang)) }}">{{ lockup(site.wordmark) }}</a>

    {#
      Site tools sit outside the frame on desktop: language in the start margin,
      mode in the end margin. On smaller screens they join the header bar.
    #}
    <div class="site-tools">
      <a class="site-tools__lang icon-btn" href="{{ key | urlFor(otherLang) }}" hreflang="{{ otherLang }}" lang="{{ otherLang }}" aria-label="{{ ui.langSwitchLabel | t(lang) }}">{{ ui.langSwitch | t(lang) }}</a>
      <button class="site-tools__theme icon-btn" type="button" data-theme-toggle aria-label="{{ ui.theme | t(lang) }}">
        <span class="theme-icon theme-icon--sun">{% icon "sun", 18 %}</span>
        <span class="theme-icon theme-icon--moon">{% icon "moon", 18 %}</span>
      </button>
    </div>

    <button class="icon-btn site-header__menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="visually-hidden">{{ ui.menu | t(lang) }}</span>
      {% icon "menu", 20 %}
    </button>

    {#
      Easter Egg Mode. Hidden in Normal mode. In Egg mode this cube replaces the menu button
      and the desktop links; the language and theme tools stay where they are.
    #}
    <button class="egg-nav" type="button" aria-expanded="false" aria-controls="egg-menu" aria-label="{{ ui.eggMenu | t(lang) }}" data-egg-nav>
      <span class="egg-nav__label" aria-hidden="true">{{ ui.eggMenu | t(lang) }}</span>
      <span class="egg-mini" aria-hidden="true" data-egg-slot>
        <span class="egg-mini__tilt"><span class="egg-mini__spin"><span class="egg-mini__box">
          <i class="f t"></i><i class="f b"></i><i class="f fr"></i><i class="f bk"></i><i class="f r"></i><i class="f l"></i>
        </span></span></span>
      </span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="{{ ui.mainNav | t(lang) }}">
      <ul class="site-nav__list">
        {%- for item in nav %}
        {%- if item.key == "services" %}
        {#- Services opens a dropdown on hover, keyboard focus or tap. In the phone menu it shows as sub-links. #}
        <li class="site-nav__item site-nav__item--menu" data-dropdown>
          <a class="site-nav__link" href="{{ item.url | t(lang) }}"{% if key == item.key %} aria-current="page"{% endif %}>{{ item.label | t(lang) }}</a>
          <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="menu-services" data-dropdown-toggle>
            <span class="visually-hidden">{{ ui.showServices | t(lang) }}</span>
            {% icon "chevron-down", 16 %}
          </button>
          <div class="site-nav__menu" id="menu-services">
            <ul class="dropdown" role="list">
              {%- for service in services %}
              <li>
                <a class="dropdown__link" href="{{ item.url | t(lang) }}#{{ service.slug }}">
                  <span class="dropdown__num">{{ loop.index | pad }}</span>
                  <span class="dropdown__title">{{ service.title | t(lang) }}</span>
                </a>
              </li>
              {%- endfor %}
            </ul>
            <a class="dropdown__all at-draw" href="{{ item.url | t(lang) }}">
              <span>{{ ui.seeAllServices | t(lang) }}</span>
              <span class="at-btn__icon">{% icon "arrow-right" %}</span>
            </a>
          </div>
        </li>
        {%- else %}
        <li class="site-nav__item">
          <a class="site-nav__link" href="{{ item.url | t(lang) }}"{% if key == item.key %} aria-current="page"{% endif %}>{{ item.label | t(lang) }}</a>
        </li>
        {%- endif %}
        {%- endfor %}
      </ul>
    </nav>
  </div>

  <nav class="egg-menu" id="egg-menu" aria-label="{{ ui.eggMenu | t(lang) }}" data-egg-menu inert>
    <ul class="egg-menu__list" role="list">
      {%- for item in nav %}
      <li style="--i: {{ loop.index0 }}"><a href="{{ item.url | t(lang) }}"{% if key == item.key %} aria-current="page"{% endif %}>{{ item.label | t(lang) }}</a></li>
      {%- endfor %}
    </ul>
    <button class="egg-menu__exit" type="button" data-egg-exit>{{ ui.eggExit | t(lang) }}</button>
  </nav>
</header>
