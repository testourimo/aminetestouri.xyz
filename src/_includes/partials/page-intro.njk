{# Page heading block. Uses: eyebrow, heading (or title), lead. #}
<section class="page-intro">
  <div class="container">
    {% if eyebrow %}<span class="label">{{ eyebrow }}</span>{% endif %}
    <h1 class="h1">{{ heading or title }}</h1>
    {% if lead %}<p class="lead body">{{ lead }}</p>{% endif %}
  </div>
</section>
