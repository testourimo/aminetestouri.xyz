---
permalink: /assets/css/main.css
eleventyExcludeFromCollections: true
---
/*
  Amine Testouri · portfolio styles
  Generated from src/_generated/main-css.njk: each import carries the version hash,
  so an update never comes from a stale browser cache.
  Order matters: tokens, then base, layout, components, pages, motion.
*/
{%- for file in ["tokens", "fonts", "base", "layout", "components", "pages", "motion"] %}
@import url("{{ file }}.css?v={{ assets.cssVersion }}");
{%- endfor %}
